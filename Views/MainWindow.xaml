                                                       FontFamily="Segoe UI Symbol"
                                                       Foreground="#EAF4FF"
                                                       Opacity="0.9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CompactIconOutward"
                                                       Text="⤡"
                                                       FontSize="20"
                                                       FontFamily="Segoe UI Symbol"
                                                       Foreground="#EAF4FF"
                                                       Opacity="0.9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
