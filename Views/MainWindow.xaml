                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontFamily="Segoe UI"
                                               FontSize="16"
                                               Foreground="#CFE8D9FF"/>
                                </Grid>
                            </Border>
                            <!-- Content -->
                            <Grid Grid.Row="1">

                                <!-- ===== AIDY PAGE ===== -->
                                <Grid x:Name="AidyPage" Visibility="Visible">

                                    <!-- header (BOUND) -->
                                    <StackPanel x:Name="AidyHeader" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource H1}"
                       HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastCommand}"
           FontSize="16"
           Opacity="0.82"
           Margin="0,8,0,0"
           HorizontalAlignment="Center"
           Foreground="{StaticResource TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>

                                                        <!-- hide when empty -->
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>

                                                        <!-- hide internal command -->
                                                        <Trigger Property="Text" Value="exit">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>

                                                        <!-- optional: hide "cancel" too -->
                                                        <Trigger Property="Text" Value="cancel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

