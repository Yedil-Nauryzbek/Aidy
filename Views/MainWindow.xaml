                            </Grid>
                        </Border>

                        <!-- ===== Main ===== -->
                        <Grid x:Name="MainArea" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TitleBarRow" Height="64"/>
