                                                       FontFamily="Consolas"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       Foreground="#EAF6FF"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>


                                <!-- ===== COMMANDS PAGE ===== -->
                                <!-- ===== COMMANDS PAGE ===== -->
                                <Grid x:Name="CommandsPage" Visibility="Collapsed" Margin="48,36,48,36">
                                    <Border CornerRadius="22"
            Background="#0EFFFFFF"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            Padding="26">
                                        <StackPanel>

                                            <TextBlock Text="AIDY BETA"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="28"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="What can AIDY do now:"
                       FontSize="16"
                       Opacity="0.82"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,18"/>

                                            <!-- Volume & Brightness -->
                                            <TextBlock Text="VOLUME &amp; BRIGHTNESS:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;volume up&quot; / &quot;volume down&quot; / &quot;louder&quot; / &quot;quieter&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;brightness up&quot; / &quot;brightness down&quot; / &quot;too dark&quot; / &quot;too bright&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;mute&quot; / &quot;shut up&quot; — &quot;unmute&quot; / &quot;sound on&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>

                                            <Border Height="14" Background="Transparent"/>

                                            <!-- System -->
                                            <TextBlock Text="SYSTEM:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;shutdown&quot; / &quot;restart&quot; / &quot;lock&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;screenshot&quot; / &quot;take screenshot&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;open cmd&quot; / &quot;terminal&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;show desktop&quot; / &quot;minimize all&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;task manager&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>

                                            <Border Height="14" Background="Transparent"/>

                                            <!-- Apps -->
                                            <TextBlock Text="APPS:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;open chrome&quot; / &quot;open telegram&quot; / &quot;open discord&quot; / …"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;close chrome&quot; / &quot;close telegram&quot; / &quot;quit discord&quot; / …"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>

                                            <TextBlock Text="Apps: Chrome, Opera, Yandex Browser, Telegram, Discord, Spotify, Explorer, Settings, Calculator, Notepad, VS Code, Steam, YouTube, ChatGPT"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.8"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

                                            <Border Height="14" Background="Transparent"/>

                                            <!-- Play Music -->
                                            <TextBlock Text="PLAY MUSIC:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;open yandex music&quot; / &quot;play music&quot; / &quot;music&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="  → Aidy asks: &quot;What do you want to listen to?&quot;"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14" Opacity="0.85" Margin="0,1,0,0"/>
                                            <TextBlock Text="  → Say the song name → opens Yandex Music search"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14" Opacity="0.85" Margin="0,1,0,0"/>

                                            <Border Height="14" Background="Transparent"/>

                                            <!-- Window switch -->
                                            <TextBlock Text="WINDOW SWITCH:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;switch window&quot; → then &quot;left&quot; / &quot;right&quot; / &quot;done&quot; / &quot;cancel&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>

                                            <Border Height="14" Background="Transparent"/>

                                            <!-- Mouse & Scroll -->
                                            <TextBlock Text="MOUSE &amp; SCROLL:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;mouse up / down / left / right&quot; – move cursor"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;click&quot; / &quot;double click&quot; / &quot;right click&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;scroll up&quot; / &quot;scroll down&quot;"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>

                                            <Border Height="14" Background="Transparent"/>

                                            <!-- Other -->
                                            <TextBlock Text="OTHER:"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       Opacity="0.9"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="• &quot;repeat&quot; / &quot;again&quot; – repeat last command"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;undo&quot; / &quot;go back&quot; – undo last action"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;timer&quot; – set a timer (Aidy asks for duration)"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>
                                            <TextBlock Text="• &quot;custom mode&quot; – run your saved action slots"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15" Opacity="0.92" Margin="0,2,0,0"/>

                                            <Border Height="18" Background="Transparent"/>

                                            <!-- Footer tip -->
                                            <Border CornerRadius="14"
                    Background="#12FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    Padding="14">
                                                <TextBlock Text="Tip: say &quot;Aidy&quot; then your command. Try &quot;open chrome&quot;, &quot;play music&quot;, &quot;volume up&quot;, &quot;switch window&quot;, or &quot;screenshot&quot;."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="14"
                           TextWrapping="Wrap"/>
                                            </Border>

                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- ===== CONTACTS PAGE ===== -->
                                <Grid x:Name="ContactsPage" Visibility="Collapsed" Margin="48,36,48,36">
                                    <Border CornerRadius="22"
            Background="#0EFFFFFF"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            Padding="26">

                                        <StackPanel>

                                            <TextBlock Text="CONTACT"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="28"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Ideas, feature requests, or feedback are welcome."
                       FontSize="16"
                       Opacity="0.88"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="14"
                    Background="#12FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    Padding="16">

                                                <StackPanel>

                                                    <TextBlock Text="Email"
                               FontSize="13"
                               Opacity="0.85"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,8"/>

                                                    <!-- clickable email -->
                                                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}">
                        <Hyperlink NavigateUri="https://e.mail.ru/compose/?to=aidysup@mail.ru"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   TextDecorations="{x:Null}">
                            <Run Text="aidysup@mail.ru"/>
                        </Hyperlink>
                                                    </TextBlock>

                                                    <TextBlock Text="AIDY is currently available for Windows."
                               FontSize="13"
                               Opacity="0.85"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>

                                                </StackPanel>
                                            </Border>

                                            <!-- optional: small hint -->
                                            <TextBlock Text="Click the email address to open mail.ru in your browser."
                       FontSize="13"
                       Opacity="0.75"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,12,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </Grid>




                                <!-- ===== SETTINGS PAGE ===== -->
                                <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="48,36,48,36">
                                    <Border CornerRadius="22"
            Background="#0EFFFFFF"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            Padding="26">
										<ScrollViewer x:Name="SettingsScrollViewerElement"
                                              Style="{StaticResource SettingsScrollViewer}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly"
                                              PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
							
											<StackPanel>
                                            <TextBlock Text="SETTINGS"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="28"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,6"/>
                                            <TextBlock Text="General"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>
                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="Start Aidy with Windows"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="OFF: app starts manually, ON: app launches automatically with Windows."
                               FontSize="13"
                               Opacity="0.82"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <ToggleButton Grid.Column="1"
                              Style="{StaticResource SettingsToggleStyle}"
                              Margin="14,0,0,0"
                              IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="Audio Settings"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                                                <StackPanel>
                                                    <TextBlock Text="Microphone (Input Device)"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,8"/>

                                                    <ComboBox Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding MicrophoneDevices}"
                              SelectedItem="{Binding SelectedMicrophoneDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Text="Output Device (Speakers / Audio Output)"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,16,0,8"/>

                                                    <ComboBox Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Startup Settings"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Greeting on Startup"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="Play a greeting sound when Aidy starts."
                                   FontSize="12"
                                   Opacity="0.82"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1"
                              Style="{StaticResource SettingsToggleStyle}"
                              Margin="12,0,0,0"
                              IsChecked="{Binding GreetingOnStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="Aidy File Location"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                                                <StackPanel>
                                                    <TextBlock Text="File path"
                               FontSize="13"
                               Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,8"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0"
                                 Style="{StaticResource SettingsInputTextBox}"
                                 Text="{Binding AidiFilePath}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"/>

                                                        <Button Grid.Column="1"
                                Style="{StaticResource SettingsActionButton}"
                                Width="110"
                                Margin="12,0,0,0"
                                Content="Browse"
                                Click="BrowseAidiFile_Click"/>
                                                    </Grid>

                                                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Text="{Binding AidiFileStatus}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAidiFilePathValid}" Value="False">
                                                                        <Setter Property="Foreground" Value="#FFB3B3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Aidy Volume"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Slider Grid.Column="0"
                            Style="{StaticResource SettingsSlider}"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding AidiVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                                                    <TextBlock Grid.Column="1"
                               Text="{Binding AidiVolumeDisplay}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                                                </Grid>
                                            </Border>

                                            <!-- ═══════════════ CUSTOM MODE ═══════════════ -->
                                            <TextBlock Text="Custom Mode"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.9"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="16"
                                                    Background="#141A2B"
                                                    BorderBrush="#2AFFFFFF"
                                                    BorderThickness="1"
                                                    Padding="18"
                                                    Margin="0,0,0,18">
                                                <StackPanel>

                                                    <!-- Master toggle row -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Custom Mode"
                                                                       FontSize="17" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="Assign 3 instant-action slots, no voice required."
                                                                       FontSize="13" Opacity="0.82"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <ToggleButton Grid.Column="1"
                                                                      Style="{StaticResource SettingsToggleStyle}"
                                                                      Margin="14,0,0,0"
                                                                      IsChecked="{Binding CustomModeEnabled, Mode=TwoWay}"/>
                                                    </Grid>

                                                    <!-- Slots panel (only when Custom Mode is ON) -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CustomModeEnabled}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <Border Height="1" Background="#22FFFFFF" Margin="0,14,0,14"/>

                                                        <TextBlock Text="Quick Action Slots"
                                                                   FontSize="13" Opacity="0.9"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   Margin="0,0,0,10"/>

                                                        <ItemsControl ItemsSource="{Binding CustomModeSlots}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,8" CornerRadius="12" Padding="14,11">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#0DFFFFFF"/>
                                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                                        <Setter Property="BorderBrush" Value="#4057F287"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Slot badge -->
                                                                            <Border Grid.Column="0" Width="26" Height="26"
                                                                                    CornerRadius="7" Background="#1B2740"
                                                                                    BorderBrush="#2D3A5D" BorderThickness="1"
                                                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SlotNumber}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="#7A8BA8"/>
                                                                            </Border>

                                                                            <!-- Slot assign button -->
                                                                            <Button Grid.Column="1"
                                                                                    Tag="{Binding Index}"
                                                                                    Click="CustomModeSlot_Click"
                                                                                    Background="Transparent"
                                                                                    BorderThickness="0"
                                                                                    HorizontalAlignment="Stretch"
                                                                                    HorizontalContentAlignment="Left"
                                                                                    Cursor="Hand" Padding="0"
                                                                                    FocusVisualStyle="{x:Null}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <ContentPresenter/>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <!-- Empty -->
                                                                                    <TextBlock Text="Click to assign action..."
                                                                                               FontSize="13" FontStyle="Italic"
                                                                                               Foreground="#3A4A5E">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <!-- Filled -->
                                                                                    <StackPanel>
                                                                                        <StackPanel.Style>
                                                                                            <Style TargetType="StackPanel">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </StackPanel.Style>
                                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                                   FontSize="13" FontWeight="SemiBold"
                                                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                                                        <TextBlock Text="{Binding ActionTypeDisplay}"
                                                                                                   FontSize="11" Foreground="#57F287"
                                                                                                   Margin="0,2,0,0"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Button>

                                                                            <!-- Run button (visible when filled) -->
                                                                            <Button Grid.Column="2"
                                                                                    Tag="{Binding Index}"
                                                                                    Click="CustomSlotExecute_Click"
                                                                                    Content="&#x25B6;"
                                                                                    Width="26" Height="26"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="8,0,0,0"
                                                                                    Cursor="Hand"
                                                                                    FocusVisualStyle="{x:Null}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Bd" CornerRadius="6" Width="26" Height="26"
                                                                                                Background="#1B2740"
                                                                                                BorderBrush="#3057F287" BorderThickness="1">
                                                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                                                       FontSize="11" Foreground="#57F287"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Bd" Property="Background" Value="#22304A"/>
                                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6057F287"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>

                                                                            <!-- Clear button (visible when filled) -->
                                                                            <Button Grid.Column="3"
                                                                                    Tag="{Binding Index}"
                                                                                    Click="CustomModeSlotClear_Click"
                                                                                    Content="&#x2715;"
                                                                                    Width="22" Height="22"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="8,0,0,0"
                                                                                    Cursor="Hand"
                                                                                    FocusVisualStyle="{x:Null}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Bd" CornerRadius="5" Width="22" Height="22"
                                                                                                Background="Transparent">
                                                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                                                       FontSize="11" Foreground="#4A5A7A"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Bd" Property="Background" Value="#1A2740"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>

                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Add slot button (up to 5) -->
                                                        <Button Click="CustomModeAddSlot_Click"
                                                                Margin="0,2,0,0" Padding="0,9"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanAddCustomSlot}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" CornerRadius="10" Padding="0,9"
                                                                            Background="Transparent"
                                                                            BorderBrush="#18FFFFFF" BorderThickness="1"
                                                                            SnapsToDevicePixels="True">
                                                                        <TextBlock Text="+ Add slot"
                                                                                   FontSize="12" FontWeight="Medium"
                                                                                   Foreground="#4A5A7A"
                                                                                   HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3057F287"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <!-- ══════════════════════════════════════════ -->

                                            <TextBlock Text="Voice"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="Push-To-Talk Mode"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="OFF: continuous listening, ON: listen only while key is held."
                               FontSize="13"
                               Opacity="0.82"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <ToggleButton Grid.Column="1"
                              Style="{StaticResource SettingsToggleStyle}"
                              Margin="14,0,0,0"
                              IsChecked="{Binding PushToTalkEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>

                                                    <Border CornerRadius="14"
                            Background="#0DFFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            Padding="14"
                            IsEnabled="{Binding IsPushToTalkHotkeySelectorEnabled}">
                                                        <StackPanel>
                                                            <TextBlock Text="Hotkey"
                               FontSize="13"
                               Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,8"/>

                                                            <DockPanel LastChildFill="False">
                                                                <Border Width="170"
                                Height="36"
                                CornerRadius="10"
                                Background="#1B2740"
                                BorderBrush="#2D3A5D"
                                BorderThickness="1"
                                Padding="12,0"
                                VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PushToTalkKeyDisplay}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                                                                </Border>

                                                                <Button Content="{Binding ChangePushToTalkKeyButtonText}"
                                Style="{StaticResource SettingsBlueActionButton}"
                                Width="138"
                                Margin="12,0,0,0"
                                Click="ChangePushToTalkKey_Click"/>
                                                            </DockPanel>

                                                            <TextBlock Text="Press a key now, or press Esc to cancel."
                               FontSize="12"
                               Foreground="#A6D2FF"
                               Margin="0,8,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPushToTalkKeyCaptureActive}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- ══════════ Preferred Apps ══════════ -->
                                            <TextBlock Text="Preferred Apps"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,18,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                                                <StackPanel>
                                                    <TextBlock Text="Primary Browser"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,8"/>

                                                    <ComboBox Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding BrowserOptions}"
                              SelectedItem="{Binding PreferredBrowser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Text="Primary Music App"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,16,0,8"/>

                                                    <ComboBox Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding MusicAppOptions}"
                              SelectedItem="{Binding PreferredMusicApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ══════════ Voice Sensitivity ══════════ -->
                                            <TextBlock Text="Voice Sensitivity"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,18,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18">
                                                <StackPanel>
                                                    <TextBlock Text="Adjust how sensitive Aidy is to your voice. Lower threshold = more sensitive."
                               FontSize="13"
                               Opacity="0.75"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"/>

                                                    <!-- VAD Threshold -->
                                                    <TextBlock Text="VAD Threshold (activation level)"
                               FontSize="13" Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"/>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding VadThresholdDisplay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="80" TextAlignment="Right"/>
                                                        <Slider Minimum="50" Maximum="500"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding VadThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsSlider}"/>
                                                    </DockPanel>

                                                    <Border Height="1" Background="#12FFFFFF" Margin="0,10,0,10"/>

                                                    <!-- Silence timeout -->
                                                    <TextBlock Text="Silence Timeout (ms before stop)"
                               FontSize="13" Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"/>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SilenceMsDisplay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="100" TextAlignment="Right"/>
                                                        <Slider Minimum="200" Maximum="2000"
                                TickFrequency="50" IsSnapToTickEnabled="True"
                                Value="{Binding SilenceMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsSlider}"/>
                                                    </DockPanel>

                                                    <Border Height="1" Background="#12FFFFFF" Margin="0,10,0,10"/>

                                                    <!-- Min speech duration -->
                                                    <TextBlock Text="Min Speech Duration (ms to register)"
                               FontSize="13" Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"/>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding MinSpeechMsDisplay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="100" TextAlignment="Right"/>
                                                        <Slider Minimum="50" Maximum="500"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding MinSpeechMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsSlider}"/>
                                                    </DockPanel>

                                                    <Border Height="1" Background="#12FFFFFF" Margin="0,12,0,12"/>

                                                    <Button Content="Reset to Defaults"
                            Style="{StaticResource SettingsBlueActionButton}"
                            Click="ResetVoiceSensitivity_Click"
                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ══════════ Mouse Control ══════════ -->
                                            <TextBlock Text="Mouse Control"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,18,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18">
                                                <StackPanel>
                                                    <TextBlock Text="Fine-tune cursor movement and scroll sensitivity for voice-controlled mouse."
                               FontSize="13"
                               Opacity="0.75"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"/>

                                                    <!-- Move distance -->
                                                    <TextBlock Text="Cursor Move Distance (px per command)"
                               FontSize="13" Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"/>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding MouseMovePxDisplay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="100" TextAlignment="Right"/>
                                                        <Slider Minimum="50" Maximum="2000"
                                TickFrequency="50" IsSnapToTickEnabled="True"
                                Value="{Binding MouseMovePx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsSlider}"/>
                                                    </DockPanel>

                                                    <Border Height="1" Background="#12FFFFFF" Margin="0,10,0,10"/>

                                                    <!-- Scroll amount -->
                                                    <TextBlock Text="Scroll Amount (clicks per command)"
                               FontSize="13" Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"/>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding MouseScrollClicksDisplay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="80" TextAlignment="Right"/>
                                                        <Slider Minimum="10" Maximum="1000"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding MouseScrollClicks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsSlider}"/>
                                                    </DockPanel>

                                                    <Border Height="1" Background="#12FFFFFF" Margin="0,10,0,10"/>

                                                    <!-- Scroll step (smoothness) -->
                                                    <TextBlock Text="Scroll Smoothness (batch size)"
                               FontSize="13" Opacity="0.9"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,6"/>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding MouseScrollStepDisplay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="80" TextAlignment="Right"/>
                                                        <Slider Minimum="1" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MouseScrollStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsSlider}"/>
                                                    </DockPanel>

                                                    <Border Height="1" Background="#12FFFFFF" Margin="0,12,0,12"/>

                                                    <Button Content="Reset to Defaults"
                            Style="{StaticResource SettingsBlueActionButton}"
                            Click="ResetMouseControl_Click"
                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ══════════ Security & Voice ID ══════════ -->
                                            <TextBlock Text="Security &amp; Voice ID"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,18,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="Voice ID"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="When ON, all commands require voice identity verification."
                               FontSize="13"
                               Opacity="0.82"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <ToggleButton Grid.Column="1"
                              Style="{StaticResource SettingsToggleStyle}"
                              Margin="14,0,0,0"
                              IsChecked="{Binding VoiceIdEnabled, Mode=TwoWay}"/>
                                                    </Grid>

                                                    <Button Content="Enroll Voice"
                            Style="{StaticResource SettingsBlueActionButton}"
                            Click="EnrollAdminVoice_Click"
                            IsEnabled="{Binding VoiceIdEnabled}"
                            HorizontalAlignment="Left"/>

                                                    <!-- Registered Voice Users -->
                                                    <TextBlock Text="Registered Users"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               Opacity="0.85"
                               Margin="0,16,0,8"
                               Visibility="{Binding VoiceIdEnabled, Converter={StaticResource BoolToVisibility}}"/>

                                                    <ItemsControl ItemsSource="{Binding VoiceUsers}"
                                  Visibility="{Binding VoiceIdEnabled, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#0DFFFFFF"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                               Text="{Binding RoleIcon}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Label}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                                                            <TextBlock FontSize="11"
                                                   Opacity="0.65"
                                                   Foreground="{StaticResource TextMuted}">
                                                                                <Run Text="{Binding Role, Mode=OneWay}"/>
                                                                                <Run Text=" · "/>
                                                                                <Run Text="{Binding Expires, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- Content -->
                        </Grid>
                        <!-- Grid Grid.Column="1" -->
                    </Grid>
                    <!-- Inner grid inside main Border (the one with 2 columns) -->
                </Border>
                <!-- Main window Border -->
            </Grid>
            <!-- Grid inside Viewbox -->
        </Viewbox>

        <Grid x:Name="EnrollmentOverlay" Background="#D90B0D18" Visibility="Collapsed" Panel.ZIndex="9000">
            <Border Width="600" Height="350" Background="#141A2B" CornerRadius="20" BorderBrush="#2EA9C7FF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#6BE7FF" Opacity="0.15" BlurRadius="40" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Voice ID Setup" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Dynamic status: updated from Python via CONTROL:enroll_text -->
                    <TextBlock x:Name="EnrollmentStatusText"
                               Text="Listening for voice instructions..."
                               FontSize="16" Foreground="#A6D2FF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               Margin="0,0,0,6"
                               Opacity="0.9"/>

                    <!-- Phrase counter: e.g. "Фраза 1 из 3" -->
                    <TextBlock x:Name="EnrollmentProgressText"
                               Text=""
                               FontSize="13" Foreground="#6BB8FF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,26"
                               Opacity="0.7"/>

                    <Grid Width="80" Height="80" Margin="0,0,0,30">
                        <Ellipse Fill="#2B4CC3FF" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.5" Duration="0:0:1" AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.5" Duration="0:0:1" AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Fill="#4CC3FF" Width="50" Height="50"/>
                        <Path Data="M 33,26 C 33,21.5 36.5,18 41,18 C 45.5,18 49,21.5 49,26 L 49,42 C 49,46.5 45.5,50 41,50 C 36.5,50 33,46.5 33,42 Z M 25,42 C 25,50.8 32.2,58 41,58 C 49.8,58 57,50.8 57,42 M 41,58 L 41,68 M 31,68 L 51,68" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-23,-15,0,0"/>
                    </Grid>

                    <Button Content="Cancel" Width="140" Height="40" Background="#FF3B5C" BorderThickness="0" Foreground="White" FontWeight="SemiBold" FontSize="14" Cursor="Hand" Click="CancelEnrollment_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SplashOverlay" Background="#0B0D18" Panel.ZIndex="9999" Visibility="Visible">
            <MediaElement x:Name="SplashVideo"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Close"
                          Stretch="UniformToFill"
                          MediaEnded="SplashVideo_MediaEnded"/>
        </Grid>
    </Grid>
    <!-- Root -->
</Window>




