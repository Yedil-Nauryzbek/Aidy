                                                 Height="94"
                                                 Fill="#1F0A1422"
                                                 Stroke="#26FFFFFF"
                                                 StrokeThickness="1"/>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="TIMER"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#AFCDE6FF"/>
