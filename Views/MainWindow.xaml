                  Stroke="#CCFFFFFF"
                  StrokeThickness="2"
                  Opacity="0.8"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M10,2 A4,4 0 1 1 9.999,2 Z M2,18 C2,13.5 18,13.5 18,18"/>
