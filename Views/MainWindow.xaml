                                            Height="34"
                                            Click="CompactToggle_Click">
                                        <Grid>
                                            <TextBlock x:Name="CompactIconInward"
                                                       Text="⤢"
                                                       FontSize="20"
                                                       FontFamily="Segoe UI Symbol"
                                                       Foreground="#EAF4FF"
                                                       Opacity="0.9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CompactIconOutward"
