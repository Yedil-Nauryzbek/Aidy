                                                <Grid.Resources>
                                                    <LinearGradientBrush x:Key="WaveBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#7C5CFF" Offset="0"/>
                                                        <GradientStop Color="#6BE7FF" Offset="0.5"/>
                                                        <GradientStop Color="#FF58B8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Grid.Resources>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="8" Height="18" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="34" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="54" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="40" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="24" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="42" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="28" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                </StackPanel>

                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#6BE7FF" Opacity="0.18" BlurRadius="12" ShadowDepth="0"/>
                                                </Grid.Effect>
                                            </Grid>
                                            <Grid x:Name="WaitingHotkeySleep"
          Width="210"
          Height="145"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Opacity="0.95">
                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#63C3FF" Opacity="0.5" BlurRadius="18" ShadowDepth="0"/>
                                                </Grid.Effect>
                                                <Canvas Width="210" Height="145" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="12" Height="12" Fill="#7ACFFF" Canvas.Left="29" Canvas.Top="112"/>
                                                    <Ellipse Width="20" Height="20" Fill="#8ED9FF" Canvas.Left="53" Canvas.Top="94"/>

                                                    <TextBlock Text="z"
                                                               FontFamily="Segoe UI"
                                                               FontSize="48"
                                                               FontWeight="Bold"
                                                               Foreground="#5EA9FF"
                                                               Canvas.Left="75"
                                                               Canvas.Top="70"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-9"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock Text="z"
                                                               FontFamily="Segoe UI"
                                                               FontSize="39"
                                                               FontWeight="Bold"
                                                               Foreground="#74BFFF"
                                                               Canvas.Left="113"
                                                               Canvas.Top="41"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-8"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock Text="z"
                                                               FontFamily="Segoe UI"
                                                               FontSize="31"
                                                               FontWeight="Bold"
                                                               Foreground="#9ADFFF"
                                                               Canvas.Left="146"
                                                               Canvas.Top="14"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-7"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Canvas>
                                            </Grid>
                                            <!-- ListeningMic removed — emblem logo is used instead -->
                                            <Grid x:Name="SpeakingWave"
          Width="220" Height="86"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Opacity="0.95">
                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#FF4FB8" Opacity="0.45" BlurRadius="16" ShadowDepth="0"/>
                                                </Grid.Effect>
                                                <StackPanel x:Name="SpeakingBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="8" Height="20" CornerRadius="4" Background="#FF77D4" Margin="3,0"/>
                                                    <Border Width="8" Height="28" CornerRadius="4" Background="#FF5FC3" Margin="3,0"/>
                                                    <Border Width="8" Height="16" CornerRadius="4" Background="#FF90E1" Margin="3,0"/>
                                                    <Border Width="8" Height="40" CornerRadius="4" Background="#FF4FB8" Margin="3,0"/>
                                                    <Border Width="8" Height="56" CornerRadius="4" Background="#FF67C9" Margin="3,0"/>
                                                    <Border Width="8" Height="30" CornerRadius="4" Background="#FF7ED8" Margin="3,0"/>
                                                    <Border Width="8" Height="68" CornerRadius="4" Background="#FF4FB8" Margin="3,0"/>
                                                    <Border Width="8" Height="24" CornerRadius="4" Background="#FF86DD" Margin="3,0"/>
                                                    <Border Width="8" Height="52" CornerRadius="4" Background="#FF58BE" Margin="3,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid x:Name="FollowUpWave"
          Width="220" Height="86"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Opacity="0.95">
                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#FFD84A" Opacity="0.5" BlurRadius="16" ShadowDepth="0"/>
                                                </Grid.Effect>
                                                <StackPanel x:Name="FollowUpBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="8" Height="20" CornerRadius="4" Background="#FFE27A" Margin="3,0"/>
                                                    <Border Width="8" Height="26" CornerRadius="4" Background="#FFD85A" Margin="3,0"/>
                                                    <Border Width="8" Height="16" CornerRadius="4" Background="#FFF0A3" Margin="3,0"/>
                                                    <Border Width="8" Height="38" CornerRadius="4" Background="#FFD84A" Margin="3,0"/>
                                                    <Border Width="8" Height="52" CornerRadius="4" Background="#FFE067" Margin="3,0"/>
                                                    <Border Width="8" Height="30" CornerRadius="4" Background="#FFED93" Margin="3,0"/>
                                                    <Border Width="8" Height="66" CornerRadius="4" Background="#FFD84A" Margin="3,0"/>
                                                    <Border Width="8" Height="24" CornerRadius="4" Background="#FFF1AA" Margin="3,0"/>
                                                    <Border Width="8" Height="46" CornerRadius="4" Background="#FFDB55" Margin="3,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- СЌС‚Рѕ Р·Р°РєСЂС‹РІР°РµС‚ Grid x:Name="Wave" -->

                                        </Grid>

                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="StudyTimerWidget"
                                          Width="132"
                                          Height="132"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,24,18"
