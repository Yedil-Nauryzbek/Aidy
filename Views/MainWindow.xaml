<!-- WpfApp1/Views/MainWindow.xaml -->
<Window x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIDY"
        Width="1100" Height="650"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Normal"
        AllowsTransparency="True"
        Background="Transparent">


    <!-- =========================
         RING STORYBOARDS (full)
         ========================= -->
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- IDLE / READY -->
        <Storyboard x:Key="SB_Ring_Idle" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#6BD6FF" Duration="0:0:0.5"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#8A6BFF" Duration="0:0:0.5"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#6BD6FF" Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.04" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.04" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NeonRing" Storyboard.TargetProperty="Opacity"
                             From="0.90" To="1.00" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.26" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="20" To="26" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- LISTENING -->
        <Storyboard x:Key="SB_Ring_Listening" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#4CC3FF" Duration="0:0:0.25"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#3E7BFF" Duration="0:0:0.25"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#4CC3FF" Duration="0:0:0.25"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.06" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.06" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.42" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="22" To="34" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever"/>

            <!-- center disk subtle scale -->
            <DoubleAnimation Storyboard.TargetName="CenterDiskScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.05" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterDiskScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.05" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterGlow" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="0.30" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="CenterGlow" Storyboard.TargetProperty="BlurRadius"
                             From="0" To="18" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- COMMAND LISTENING — bright cyan pulse, faster & more energetic than passive Listening -->
        <Storyboard x:Key="SB_Ring_CommandListening" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#00E5FF" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#40CFFF" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#00E5FF" Duration="0:0:0.15"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.02" To="1.10" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.02" To="1.10" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#00E5FF" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.70" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="26" To="48" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>

            <!-- center disk scale — slightly larger to feel "ready" -->
            <DoubleAnimation Storyboard.TargetName="CenterDiskScale" Storyboard.TargetProperty="ScaleX"
                             From="1.02" To="1.08" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterDiskScale" Storyboard.TargetProperty="ScaleY"
                             From="1.02" To="1.08" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterGlow" Storyboard.TargetProperty="Opacity"
                             From="0.10" To="0.45" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="CenterGlow" Storyboard.TargetProperty="BlurRadius"
                             From="4" To="22" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- EMBLEM VAD pulse — started/stopped by C# on voice activity only -->
        <Storyboard x:Key="SB_Emblem_Active" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmblemScale" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.11"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="1.09"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="1.13"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.00" Value="1.00"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmblemScale" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.11"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="1.09"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="1.13"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.00" Value="1.00"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="EmblemGlow" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.70" Duration="0:0:0.30" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="EmblemGlow" Storyboard.TargetProperty="BlurRadius"
                             From="8" To="38" Duration="0:0:0.30" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- PROCESSING -->
        <Storyboard x:Key="SB_Ring_Processing" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#7A6CFF" Duration="0:0:0.35"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#B05CFF" Duration="0:0:0.35"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#7A6CFF" Duration="0:0:0.35"/>

            <DoubleAnimation Storyboard.TargetName="RingGradientRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:7" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.03" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.03" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.20" To="0.28" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- SPEAKING -->
        <Storyboard x:Key="SB_Ring_Speaking" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#B85CFF" Duration="0:0:0.25"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FF4FB8" Duration="0:0:0.25"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#B85CFF" Duration="0:0:0.25"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FF4FB8" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="0.55" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="26" To="44" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- EXECUTING -->
        <Storyboard x:Key="SB_Ring_Executing" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#4CC3FF" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#39FFB0" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#4CC3FF" Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.08" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.08" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#39FFB0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.30" To="0.60" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- SUCCESS (one ping then code-behind returns to Idle) -->
        <Storyboard x:Key="SB_Ring_Success">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#36E58C" Duration="0:0:0.12"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#36E58C" Duration="0:0:0.12"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#36E58C" Duration="0:0:0.12"/>

            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#36E58C" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity" From="0.25" To="0.75" Duration="0:0:0.18" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius" From="22" To="52" Duration="0:0:0.18" AutoReverse="True"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="1.00" To="1.10" Duration="0:0:0.18" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="1.00" To="1.10" Duration="0:0:0.18" AutoReverse="True"/>
        </Storyboard>

        <!-- WARNING -->
        <Storyboard x:Key="SB_Ring_Warning" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#FFB020" Duration="0:0:0.35"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FFB020" Duration="0:0:0.35"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#FFB020" Duration="0:0:0.35"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FFB020" Duration="0:0:0.35"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="1.00" To="1.03" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="1.00" To="1.03" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.32" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- ERROR -->
        <Storyboard x:Key="SB_Ring_Error">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#FF3B5C" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FF2A2A" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#FF3B5C" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FF3B5C" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius" To="46" Duration="0:0:0.15"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="1.10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="1.02"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="1.12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.40" Value="1.01"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="1.10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="1.10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="1.02"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="1.12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.40" Value="1.01"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="1.10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ACCESS DENIED — red flash + shake -->
        <Storyboard x:Key="SB_Ring_AccessDenied">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#FF2A2A" Duration="0:0:0.1"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FF0000" Duration="0:0:0.1"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#FF2A2A" Duration="0:0:0.1"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FF0000" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius" To="55" Duration="0:0:0.1"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="1.12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.96"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.08"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0.98"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1.04"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="1.12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.96"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.08"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0.98"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1.04"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- OFFLINE -->
        <Storyboard x:Key="SB_Ring_Offline" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#2B355A" Duration="0:0:0.4"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#2B355A" Duration="0:0:0.4"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#2B355A" Duration="0:0:0.4"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#2B355A" Duration="0:0:0.4"/>

            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity" From="0.08" To="0.14" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonRing" Storyboard.TargetProperty="Opacity" From="0.55" To="0.70" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="1.00" To="1.01" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="1.00" To="1.01" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- FOLLOWUP (yellow — matches the yellow waveform bars) -->
        <Storyboard x:Key="SB_Ring_FollowUp" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#FFD84A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FFE27A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#FFD84A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FFD84A" Duration="0:0:0.3"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.30" To="0.60" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="24" To="44" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- GRANT ROLE (pink — "User or Admin?") -->
        <Storyboard x:Key="SB_Ring_GrantRole" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#FF6EB4" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FF4F9A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#FF6EB4" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FF6EB4" Duration="0:0:0.3"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.30" To="0.60" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="24" To="44" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- GRANT DURATION (yellow — "By how much? 1-60") -->
        <Storyboard x:Key="SB_Ring_GrantDuration" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="RingStop1" Storyboard.TargetProperty="Color" To="#FFD84A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="RingStop2" Storyboard.TargetProperty="Color" To="#FFE27A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="RingStop3" Storyboard.TargetProperty="Color" To="#FFD84A" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Color" To="#FFD84A" Duration="0:0:0.3"/>

            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="1.00" To="1.05" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="Opacity"
                             From="0.30" To="0.60" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="NeonShadow" Storyboard.TargetProperty="BlurRadius"
                             From="24" To="44" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Style x:Key="SettingsInputTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2E9BB6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#65B6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#141A2B"/>
            <Setter Property="BorderBrush" Value="#2E9BB6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Visible box -->
                            <Border x:Name="Bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="12,4,4,4"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{StaticResource TextPrimary}"/>
                                    <Path Grid.Column="1"
                                          x:Name="Arrow"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{StaticResource TextMuted}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <!-- Transparent toggle covering the whole area to handle clicks -->
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0"/>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#141A2B"
                                        BorderBrush="#2E9BB6FF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,2,0,0"
                                        ClipToBounds="True"
                                        MaxHeight="202"
                                        MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        MaxWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  MaxHeight="200"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  ClipToBounds="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#65B6FF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#65B6FF"/>
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="4,2"
                                            CornerRadius="7">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1E2E50"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1A2D5A"/>
                                            <Setter Property="Foreground" Value="#9BB6FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled scrollbar for settings panel -->
        <Style x:Key="SettingsScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4"
                                Background="#40738FFF"
                                Margin="2,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Thumb}}" Value="True">
                                            <Setter Property="Background" Value="#709BB6FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border CornerRadius="4"
                                    Background="#151E36"
                                    Margin="2,4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource SettingsScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim styled Slider for settings -->
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <!-- Track background -->
                            <Border Height="4" Background="#1B2740" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#4A9BB6FF" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#9BB6FF">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#9BB6FF" Opacity="0.55" BlurRadius="8" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#1B2740" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#339BB6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PushToTalkToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    CornerRadius="16"
                                    Background="#2AFFFFFF"
                                    BorderBrush="#309BB6FF"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Thumb"
                                     Width="24" Height="24"
                                     Fill="#F4FAFF"
                                     HorizontalAlignment="Left"
                                     Margin="4,4,0,4">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#80000000" BlurRadius="8" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2B4CC3FF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6BC9FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,4,4,4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared animated toggle for Settings page -->
        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchTrack"
                                Width="58" Height="32"
                                CornerRadius="16"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#2E3A57"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#3C4C73"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Ellipse x:Name="SwitchThumb"
                                         Width="24" Height="24"
                                         Fill="#F3F6FF"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#1E7A57" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#39B987" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="26" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#2E3A57" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#3C4C73" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue action button with proper disabled state -->
        <Style x:Key="SettingsBlueActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#1B3D72"/>
            <Setter Property="BorderBrush" Value="#3A72BF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EAF3FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A5AAA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6ABF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#0E1A2B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E2B42"/>
                                <Setter Property="Foreground" Value="#2E4060"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- ===== App Window (center) ===== -->
        <Viewbox x:Name="AppScaleHost" Stretch="Uniform" StretchDirection="Both">
            <Grid x:Name="AppDesignRoot" Width="1536" Height="864">

                <Border x:Name="MainShell" Width="1413" Height="743"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource WindowFill}"
                        BorderBrush="{StaticResource WindowBorder}"
                        BorderThickness="1"
                        Effect="{StaticResource WindowShadow}">

                    <Grid x:Name="ShellRoot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SidebarColumn" Width="290"/>
                            <ColumnDefinition x:Name="MainColumn" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===== Sidebar ===== -->
                        <Border x:Name="SidebarPanel" Grid.Column="0"
                                CornerRadius="28,0,0,28"
                                Background="{StaticResource SidebarFill}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- divider -->
                                <Border BorderBrush="#269BB6FF" BorderThickness="0,0,1,0"/>

                                <!-- top: logo + AIDY -->
                                <StackPanel Grid.Row="0" Margin="24,28,24,0" Orientation="Horizontal">
                                    <Image Width="44"
                                           Height="44"
                                           Source="pack://application:,,,/Assets/logo.png"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           Effect="{StaticResource GlowLogo}"/>

                                    <TextBlock Text="AIDY"
                                               Margin="14,2,0,0"
                                               FontFamily="Segoe UI"
                                               FontWeight="SemiBold"
                                               FontSize="28"
                                               Foreground="{StaticResource TextPrimary}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="4"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>

                                <!-- menu -->
                                <!-- menu -->
                                <StackPanel Grid.Row="1" Margin="24,32,24,0">

                                    <!-- AIDY -->
                                    <Button x:Name="BtnAidy"
            Style="{StaticResource MenuItemButton}"
            Background="#8C2B3C8A"
            BorderBrush="#2EA9C7FF"
            BorderThickness="1"
            Click="NavAidy_Click">
                                        <Grid Margin="16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="20" Height="20"
                     Stroke="#CCFFFFFF" StrokeThickness="2" Opacity="0.85"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Text="Aidy"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                    </Button>

                                    <!-- COMMANDS -->
                                    <Button x:Name="BtnCommands"
            Style="{StaticResource MenuItemButton}"
            Click="NavCommands_Click">
                                        <Grid Margin="16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0"
                  Stroke="#CCFFFFFF"
                  StrokeThickness="2"
                  Opacity="0.8"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M4,5 H18 M4,10 H18 M4,15 H14"/>

                                            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Text="Commands"
                       Style="{StaticResource MenuText}"/>
                                        </Grid>
                                    </Button>

                                    <!-- CONTACTS -->
                                    <Button x:Name="BtnContacts"
            Style="{StaticResource MenuItemButton}"
