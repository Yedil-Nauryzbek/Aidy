                                                    <ScaleTransform x:Name="EmblemScale" ScaleX="1" ScaleY="1"/>
                                                </Image.RenderTransform>
                                                <Image.Effect>
                                                    <DropShadowEffect x:Name="EmblemGlow" Color="#00FFFF" Opacity="0" BlurRadius="0" ShadowDepth="0"/>
