                                                       FontSize="20"
                                                       FontFamily="Segoe UI Symbol"
                                                       Foreground="#EAF4FF"
                                                       Opacity="0.9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="CompactToWindowsSpacer" Width="14"/>
                                    <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" Click="Minimize_Click">
                                        <TextBlock Text="&#x2014;" FontSize="18" FontWeight="SemiBold" Opacity="0.7" Foreground="White"/>
                                    </Button>
                                    <Border x:Name="MinimizeToMaximizeSpacer" Width="14"/>
                                    <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Click="Maximize_Click">
                                        <TextBlock Text="&#x25A1;" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Foreground="White"/>
                                    </Button>
                                    <Border x:Name="MaximizeToCloseSpacer" Width="14"/>
                                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Click="Close_Click">
                                        <TextBlock Text="&#x2715;" FontSize="18" FontWeight="SemiBold" Opacity="0.7" Foreground="White"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="StudyTipsPanel"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,18,24,0"
                                    Width="220"
                                    CornerRadius="18"
                                    Background="#4A4B2FD1"
                                    BorderBrush="#5CFFFFFF"
                                    BorderThickness="1"
                                    Padding="14"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="Tips"
                                               HorizontalAlignment="Center"
                                               FontFamily="Segoe UI"
                                               FontWeight="SemiBold"
                                               FontSize="20"
                                               Foreground="#DDE8D9FF"/>
                                    <TextBlock Grid.Row="1"
                                               Text="To turn off study mode,&#10;say end / stop / exit."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontFamily="Segoe UI"
                                               FontSize="16"
                                               Foreground="#CFE8D9FF"/>
                                </Grid>
                            </Border>
                            <!-- Content -->
                            <Grid Grid.Row="1">

                                <!-- ===== AIDY PAGE ===== -->
                                <Grid x:Name="AidyPage" Visibility="Visible">

                                    <!-- header (BOUND) -->
                                    <StackPanel x:Name="AidyHeader" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource H1}"
                       HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastCommand}"
           FontSize="16"
           Opacity="0.82"
           Margin="0,8,0,0"
           HorizontalAlignment="Center"
           Foreground="{StaticResource TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>

                                                        <!-- hide when empty -->
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>

                                                        <!-- hide internal command -->
                                                        <Trigger Property="Text" Value="exit">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>

                                                        <!-- optional: hide "cancel" too -->
                                                        <Trigger Property="Text" Value="cancel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                    </StackPanel>
                                    <StackPanel x:Name="CompactStateHost"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,20,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="22"
                                                   Margin="0,0,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>

                                    <!-- ===== Listening Orb ===== -->
                                    <Grid x:Name="OrbHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,30,0,0">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1"/>
                                        </Grid.LayoutTransform>
                                        <Grid Width="520" Height="520">

                                            <!-- outer glow pulse -->
                                            <Ellipse x:Name="OuterGlow" Width="520" Height="520">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#2E7C5CFF" Offset="0"/>
                                                        <GradientStop Color="#007C5CFF" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="OuterGlowScale"
                            CenterX="260" CenterY="260"
                            ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>

                                            <!-- ring group (ROTATES) -->
                                            <Grid>
                                                <Grid.RenderTransform>
                                                    <RotateTransform x:Name="RingRotate" CenterX="260" CenterY="260" Angle="0"/>
                                                </Grid.RenderTransform>

                                                <!-- neon ring (STATE-driven) -->
                                                <Ellipse x:Name="NeonRing"
                 Width="360" Height="360"
                 StrokeThickness="17"
                 Opacity="0.95"
                 RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
                                                    </Ellipse.RenderTransform>

                                                    <Ellipse.Stroke>
                                                        <LinearGradientBrush x:Name="RingGradient" StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop x:Name="RingStop1" Color="#6BE7FF" Offset="0"/>
                                                            <GradientStop x:Name="RingStop2" Color="#7C5CFF" Offset="0.55"/>
                                                            <GradientStop x:Name="RingStop3" Color="#6BE7FF" Offset="1"/>

                                                            <LinearGradientBrush.RelativeTransform>
                                                                <RotateTransform x:Name="RingGradientRotate" CenterX="0.5" CenterY="0.5" Angle="0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Stroke>

                                                    <Ellipse.Effect>
                                                        <DropShadowEffect x:Name="NeonShadow"
                                  Color="#6BE7FF"
                                  Opacity="0.22"
                                  BlurRadius="22"
                                  ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <!-- extra subtle glows -->
                                                <Ellipse Width="360" Height="360" StrokeThickness="10" Stroke="#30FF58B8" Effect="{StaticResource GlowPink}"/>
                                                <Ellipse Width="360" Height="360" StrokeThickness="10" Stroke="#207C5CFF" Effect="{StaticResource GlowViolet}"/>
                                            </Grid>
                                            <!-- вњ… ring group closed -->

                                            <!-- inner ring (STATIC) -->
                                            <Ellipse Width="310" Height="310" StrokeThickness="7" Stroke="#26FFFFFF"/>

                                            <!-- center disk (STATIC) -->
                                            <Ellipse Width="270" Height="270" StrokeThickness="1" Stroke="#2EA9C7FF" Fill="#A60B0D18">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="28" ShadowDepth="0"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <!-- waveform (STATIC) -->
                                            <Grid x:Name="Wave"
          Width="170" Height="64"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="WaveScale" CenterX="85" CenterY="32" ScaleX="1" ScaleY="1"/>
                                                </Grid.RenderTransform>

                                                <Grid.Resources>
                                                    <LinearGradientBrush x:Key="WaveBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#7C5CFF" Offset="0"/>
                                                        <GradientStop Color="#6BE7FF" Offset="0.5"/>
                                                        <GradientStop Color="#FF58B8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Grid.Resources>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="8" Height="18" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="34" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="54" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="40" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="24" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="42" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                    <Rectangle Width="8" Height="28" RadiusX="3" RadiusY="3" Fill="{StaticResource WaveBrush}" Margin="4,0"/>
                                                </StackPanel>

                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#6BE7FF" Opacity="0.18" BlurRadius="12" ShadowDepth="0"/>
                                                </Grid.Effect>
                                            </Grid>
                                            <Grid x:Name="WaitingHotkeySleep"
          Width="210"
          Height="145"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Opacity="0.95">
                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#63C3FF" Opacity="0.5" BlurRadius="18" ShadowDepth="0"/>
                                                </Grid.Effect>
                                                <Canvas Width="210" Height="145" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="12" Height="12" Fill="#7ACFFF" Canvas.Left="29" Canvas.Top="112"/>
                                                    <Ellipse Width="20" Height="20" Fill="#8ED9FF" Canvas.Left="53" Canvas.Top="94"/>

                                                    <TextBlock Text="z"
                                                               FontFamily="Segoe UI"
                                                               FontSize="48"
                                                               FontWeight="Bold"
                                                               Foreground="#5EA9FF"
                                                               Canvas.Left="75"
                                                               Canvas.Top="70"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-9"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock Text="z"
                                                               FontFamily="Segoe UI"
                                                               FontSize="39"
                                                               FontWeight="Bold"
                                                               Foreground="#74BFFF"
                                                               Canvas.Left="113"
                                                               Canvas.Top="41"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-8"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock Text="z"
                                                               FontFamily="Segoe UI"
                                                               FontSize="31"
                                                               FontWeight="Bold"
                                                               Foreground="#9ADFFF"
                                                               Canvas.Left="146"
                                                               Canvas.Top="14"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-7"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Canvas>
                                            </Grid>
                                            <Grid x:Name="ListeningMic"
          Width="100" Height="118"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed">
                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#68FFE8" Opacity="0.38" BlurRadius="14" ShadowDepth="0"/>
                                                </Grid.Effect>
                                                <Canvas Width="100" Height="118" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="40" Height="58" CornerRadius="20" Background="#68FFE8" Canvas.Left="30" Canvas.Top="10"/>
                                                    <Path Data="M22,62 A28,28 0 0 0 78,62" Stroke="#68FFE8" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                                    <Border Width="10" Height="18" CornerRadius="5" Background="#68FFE8" Canvas.Left="45" Canvas.Top="78"/>
                                                    <Border Width="50" Height="10" CornerRadius="5" Background="#68FFE8" Canvas.Left="25" Canvas.Top="96"/>
                                                </Canvas>
                                            </Grid>
                                            <Grid x:Name="SpeakingWave"
          Width="220" Height="86"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Opacity="0.95">
                                                <Grid.Effect>
                                                    <DropShadowEffect Color="#FF4FB8" Opacity="0.45" BlurRadius="16" ShadowDepth="0"/>
                                                </Grid.Effect>
                                                <StackPanel x:Name="SpeakingBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="8" Height="20" CornerRadius="4" Background="#FF77D4" Margin="3,0"/>
                                                    <Border Width="8" Height="28" CornerRadius="4" Background="#FF5FC3" Margin="3,0"/>
                                                    <Border Width="8" Height="16" CornerRadius="4" Background="#FF90E1" Margin="3,0"/>
