                                                <Canvas Width="100" Height="100">
                                                    <Line X1="20" Y1="20" X2="80" Y2="80"
                                                          Stroke="#FF2A2A" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Line X1="80" Y1="20" X2="20" Y2="80"
                                                          Stroke="#FF2A2A" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                                <Viewbox.Effect>
                                                    <DropShadowEffect Color="#FF0000" Opacity="0.7" BlurRadius="20" ShadowDepth="0"/>
                                                </Viewbox.Effect>
                                                <Viewbox.RenderTransform>
                                                    <ScaleTransform x:Name="DeniedCrossScale" ScaleX="1" ScaleY="1"/>
                                                </Viewbox.RenderTransform>
                                            </Viewbox>

                                            <!-- waveform (STATIC) -->
                                            <Grid x:Name="Wave"
          Width="170" Height="64"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
