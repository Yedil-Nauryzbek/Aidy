                                Height="36"
                                CornerRadius="10"
                                Background="#1B2740"
                                BorderBrush="#2D3A5D"
                                BorderThickness="1"
                                Padding="12,0"
                                VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PushToTalkKeyDisplay}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                                                                </Border>

                                                                <Button Content="{Binding ChangePushToTalkKeyButtonText}"
                                Width="138"
                                Height="36"
                                Margin="12,0,0,0"
                                Click="ChangePushToTalkKey_Click"
                                Background="#1B3D72"
                                BorderBrush="#3A72BF"
                                BorderThickness="1"
                                Foreground="#EAF3FF"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                                                            </DockPanel>

                                                            <TextBlock Text="Press a key now, or press Esc to cancel."
                               FontSize="12"
                               Foreground="#A6D2FF"
                               Margin="0,8,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPushToTalkKeyCaptureActive}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Security &amp; Voice ID"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Opacity="0.9"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,18,0,14"/>

                                            <Border CornerRadius="16"
                    Background="#141A2B"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1"
                    Padding="18">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="Voice ID"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="When ON, all commands require voice identity verification."
                               FontSize="13"
                               Opacity="0.82"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <ToggleButton Grid.Column="1"
                              Width="58"
                              Height="32"
                              Margin="14,0,0,0"
                              Cursor="Hand"
                              Focusable="False"
                              IsChecked="{Binding VoiceIdEnabled, Mode=TwoWay}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="SwitchTrack"
                                Width="58"
                                Height="32"
                                CornerRadius="16"
                                Background="#2E3A57"
                                BorderBrush="#3C4C73"
                                BorderThickness="1">
                                                                        <Grid>
                                                                            <Ellipse x:Name="SwitchThumb"
                                     Width="24"
                                     Height="24"
                                     Fill="#F3F6FF"
                                     Margin="4,4,0,4"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#5F74A8"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="SwitchTrack" Property="Background" Value="#1E7A57"/>
                                                                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#39B987"/>
                                                                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,4,4,4"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                    </Grid>

                                                    <Button Content="Enroll Voice"
                            Height="36"
                            Click="EnrollAdminVoice_Click"
                            IsEnabled="{Binding VoiceIdEnabled}"
                            Background="#1B3D72"
                            BorderBrush="#3A72BF"
                            BorderThickness="1"
                            Foreground="#EAF3FF"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Padding="18,0"/>
                                                </StackPanel>
                                            </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- Content -->
                        </Grid>
                        <!-- Grid Grid.Column="1" -->
                    </Grid>
                    <!-- Inner grid inside main Border (the one with 2 columns) -->
                </Border>
                <!-- Main window Border -->
            </Grid>
            <!-- Grid inside Viewbox -->
        </Viewbox>

        <Grid x:Name="SplashOverlay" Background="#0B0D18" Panel.ZIndex="9999" Visibility="Visible">
            <MediaElement x:Name="SplashVideo"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Close"
                          Stretch="UniformToFill"
                          MediaEnded="SplashVideo_MediaEnded"/>
        </Grid>
    </Grid>
    <!-- Root -->
</Window>




